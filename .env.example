# 无需配置即可使用两种模拟模型。密钥只在后端读取。
HOST=127.0.0.1
PORT=4317
# API base endpoint; include /v1 when required. Protocol: responses or chat-completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_ALT=
LLM_PROTOCOL=responses
# Chat Completions output field; blank selects max_tokens for DeepSeek official API.
LLM_MAX_TOKENS_FIELD=
LLM_CONTEXT_WINDOW=32768
LLM_MAX_OUTPUT=2048
# Secondary model may have a different capacity; blank inherits primary.
LLM_CONTEXT_WINDOW_ALT=
LLM_MAX_OUTPUT_ALT=
# Optional: DeepSeek official API supports none (disable thinking), low / high / max.
LLM_REASONING_EFFORT=
# Root for isolated demo workspaces, event logs and artifacts.
HARNESS_DATA_DIR=.harness
