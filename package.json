{
  "name": "harness-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs test/*.test.ts",
    "test:core": "node --test test/first-round.test.mjs test/*.test.ts",
    "typecheck:runtime": "node web/node_modules/typescript/bin/tsc -p tsconfig.runtime.json",
    "lint": "node scripts/lint.mjs",
    "test:scale": "node scripts/scale.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "build": "node scripts/build.mjs",
    "catalog": "node scripts/catalog.mjs",
    "test:capabilities": "node --test test/capabilit*.test.mjs",
    "test:catalog-scale": "node scripts/capability-scale.mjs",
    "desktop": "node scripts/desktop.mjs",
    "build:desktop": "node scripts/desktop.mjs --build-only"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
